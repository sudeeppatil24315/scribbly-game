# Production Environment Variables
# Copy these to your Railway/Render dashboard

# Server
PORT=3001
NODE_ENV=production

# Database (Supabase) - Connection Pooling URL
# Get from: Supabase Dashboard → Settings → Database → Connection Pooling
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Redis (Upstash)
# Get from: Upstash Dashboard → Your Database → REST API
REDIS_URL=redis://default:[PASSWORD]@[ENDPOINT].upstash.io:6379

# JWT - CHANGE THESE IN PRODUCTION!
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-STRING-AT-LEAST-32-CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth (Optional for launch)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS - Your Vercel frontend URL
CORS_ORIGIN=https://your-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Sentry (Optional)
SENTRY_DSN=
